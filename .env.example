# Canonical list of environment variables. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values may reach the browser (AGENTS.md §12).

# Clerk — publishable key is client-safe, secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity — project id, dataset and API version are client-safe.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-10

# Read token for the private dataset. Server-only — never exposed to the
# browser, and read only through sanity/lib/token.ts.
SANITY_API_READ_TOKEN=

# PostHog — the project token is public by design and may reach the browser.
# Any private PostHog API key stays server-only (AGENTS.md §12).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Sanity Context MCP — the search agent's endpoint (AGENTS.md §10). The trailing
# slug applies the `sanity.agentContext` document's instructions and content
# filter. Server-only: it is called with SANITY_API_READ_TOKEN as a bearer.
# https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search
SANITY_CONTEXT_MCP_URL=

# Google Gemini — the search agent's model. Server-only; the browser never
# calls it. A free AI Studio key works: https://aistudio.google.com/apikey
# The variable name is the one @ai-sdk/google reads by default.
GOOGLE_GENERATIVE_AI_API_KEY=
SEARCH_MODEL=gemini-flash-lite-latest
